# Copy this file to `.env` and fill in the credentials for the platforms you use.
# NEVER commit your real `.env` file.

# ---------------------------------------------------------------- General
LOG_LEVEL=INFO
LOG_DIR=logs
# Comma separated platform keys or "all":
# telegram,discord,mastodon,bluesky,github_gist,devto,huggingface
ENABLED_PLATFORMS=all
REQUEST_TIMEOUT=15
PLATFORM_TIMEOUT=30
# Confirm public access with an anonymous GET of each posted URL
VERIFY_PUBLIC_ACCESS=true
# IANA timezone for the date/time fields (e.g. UTC, Asia/Kolkata)
TIMEZONE=UTC

# ---------------------------------------------------------------- Telegram
# Create a bot with @BotFather, add it as admin of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# ---------------------------------------------------------------- Discord
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------- Mastodon
# Preferences -> Development -> New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ---------------------------------------------------------------- Bluesky
# Settings -> Privacy and security -> App passwords
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# ---------------------------------------------------------------- GitHub Gist
# Settings -> Developer settings -> Personal access tokens (scope: gist)
GITHUB_TOKEN=

# ---------------------------------------------------------------- DEV Community
# https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=
DEVTO_TAGS=business,marketing

# ---------------------------------------------------------------- Hugging Face
# https://huggingface.co/settings/tokens (write access)
# Repo you own where discussions will be opened, e.g. username/announcements
HF_TOKEN=
HF_REPO_ID=
# model | dataset | space
HF_REPO_TYPE=model
